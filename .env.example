# Bumayed — environment variables (names + descriptions only, never real values)
# Copy to `.env.local` and fill in. Validated by src/lib/env.ts at boot.

# --- Phase 3: database -------------------------------------------------------
# PostgreSQL connection string (managed instance in production)
# Local Docker Compose maps host 5433 → container 5432 (avoids Windows Postgres on 5432)
DATABASE_URL="postgresql://bumayed:bumayed_dev_password@127.0.0.1:5433/bumayed"

# --- Phase 4: auth & email ---------------------------------------------------
# Random 32+ char secret for session/token signing (e.g. `openssl rand -base64 32`)
AUTH_SECRET=""
# Public site URL used by Auth.js for callbacks (local: http://localhost:3000)
AUTH_URL="http://localhost:3000"
# Verified sender address for verification/notification emails
EMAIL_FROM="noreply@example.com"
# API key for the chosen email provider (Resend/SES). Without it, emails log to console in development.
EMAIL_PROVIDER_API_KEY=""

# --- Phase 11: Cloudflare R2 (S3-compatible). Leave blank to use local disk. --
# Endpoint looks like https://<accountid>.r2.cloudflarestorage.com
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
STORAGE_BUCKET="bumayed"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
# Public r2.dev or custom domain, no trailing slash. Example: https://pub-xxxx.r2.dev
STORAGE_PUBLIC_URL=""
# Same public URL, exposed to the browser so listing cards can load new photos.
NEXT_PUBLIC_STORAGE_PUBLIC_URL=""
# Soft cap on images per listing (owner rule: no fixed limit; abuse guard)
MAX_IMAGES_PER_LISTING="30"
MAX_IMAGE_SIZE_MB="10"

# --- SMS/OTP (DEFERRED by owner — keep disabled) ------------------------------
FEATURE_OTP_ENABLED="false"
SMS_PROVIDER_API_KEY=""

# --- Phase 7: payments (one provider, selected by client) --------------------
# One of: telr | ni | stripe
PAYMENT_PROVIDER=""
PAYMENT_PROVIDER_API_KEY=""
PAYMENT_PROVIDER_WEBHOOK_SECRET=""
# Sandbox checkout lets a buyer mark their own payment as paid. Always on in
# development; in production only when "true". Set to "false" before launch.
ALLOW_SANDBOX_PAYMENTS="false"

# --- Daily expiry sweep (Vercel cron in vercel.json) --------------------------
# Random string. Vercel sends it as a Bearer token to the cron route.
CRON_SECRET=""

# --- Monitoring ---------------------------------------------------------------
SENTRY_DSN=""
