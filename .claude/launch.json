{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "dev-local",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:DATABASE_URL='postgresql://bumayed:bumayed_dev_password@127.0.0.1:5433/bumayed'; npx next dev -p 3001"
      ],
      "port": 3001
    }
  ]
}