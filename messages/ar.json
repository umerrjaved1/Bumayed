  "content": {
    "draftNotice": "محتوى مبدئي — بانتظار اعتماد العميل قبل الإطلاق.",
    "about": {
      "title": "عن بوميّد",
      "p1": "بوميّد سوق إماراتي متخصص في المركبات: السيارات والدراجات النارية والقوارب. نربط المشترين والبائعين مباشرة في جميع الإمارات السبع — دون وسطاء ودون رسوم خفية.",
      "p2": "سواء كنت فرداً يبيع سيارته أو معرضاً يدير صالة عرض كاملة، يمنحك بوميّد الأدوات للوصول إلى مشترين جادين بالعربية والإنجليزية."
    },
    "faq": {
      "title": "الأسئلة الشائعة",
      "q1": "كيف أنشر إعلاناً؟",
      "a1": "أنشئ حساباً مجانياً، واضغط «أضف إعلانك»، واختر الفئة واتبع الخطوات. يُنشر إعلانك بعد مراجعة إشرافية سريعة.",
      "q2": "هل النشر مجاني؟",
      "a2": "نعم — الإعلانات العادية مجانية للأفراد والمعارض. وتمنح العروض الاختيارية (مميز، بريميوم، عاجل) إعلانك ظهوراً إضافياً.",
      "q3": "كيف أتواصل مع البائع؟",
      "a3": "يحتوي كل إعلان على زري اتصال وواتساب يربطانك بالبائع مباشرة. لا يتدخل بوميّد في تفاوضك.",
      "q4": "كيف يتم توثيق المعارض؟",
      "a4": "يرفع المعرض رخصته التجارية ومستنداته عبر لوحة تحكم المعرض، ويراجعها فريقنا قبل إظهار شارة التوثيق."
    },
    "terms": {
      "title": "الشروط والأحكام",
      "p1": "تحكم هذه الشروط المبدئية استخدام سوق بوميّد. باستخدامك الموقع فأنت توافق على تقديم معلومات إعلان دقيقة وعلى الالتزام بقوانين دولة الإمارات.",
      "p2": "بوميّد منصة إعلانات مبوبة: لا نشارك في بيع المركبات أو الدفع أو التسليم ولسنا طرفاً في أي صفقة بين المشترين والبائعين.",
      "p3": "سيتم توفير الصياغة القانونية النهائية واعتمادها من العميل قبل الإطلاق."
    },
    "privacy": {
      "title": "سياسة الخصوصية",
      "p1": "توضح هذه السياسة المبدئية البيانات التي يجمعها بوميّد (بيانات الحساب والإعلانات وتفضيلات التواصل) وسبب جمعها: لتشغيل السوق وربط المشترين بالبائعين.",
      "p2": "لا نبيع بياناتك الشخصية أبداً. سيتم توفير الصياغة النهائية واعتمادها من العميل قبل الإطلاق، بما يتوافق مع قانون حماية البيانات الإماراتي."
    },
